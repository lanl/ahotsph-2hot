defaultCC:=gcc
override LD:=cc

CC_SPECIFIC:=-g -Wall -std=c99 -D_XOPEN_SOURCE=500
ARCH_SPECIFIC:=-march=bdver1 -mprefer-avx128 -DXK6 -DSTK_FORCE_ALIGNMENT=4 -D_FILE_OFFSET_BITS=64 -DUSE_SYSTEM_MALLOC -DUSE_MPIIO -DUSE_HWCLOCK -DPROCS_PER_NODE=16
OPTIMIZE=-O2
AGGRESSIVE_OPT=-Ofast
LDFLAGS=-g
LEX:=flex
YACC:=bison -y

include $(treedir)/Make-common/Make.default

swsrc:=
asmdir:=asm-sse
asmsrc=do_grav_sse64_noswiz.s do_grav_sse64_noswiz_eps.s do_grav_sse64_nr.s
cppasmsrc=do_grav_sse16_ivec.S

LOADLIBES=-lrt

ifeq ($(PAROS),mpi)
LOADLIBES:=-L$(MPICH_DIR)/lib -lmpich
PAROSCFLAGS:=-I$(MPICH_DIR)/include
endif

