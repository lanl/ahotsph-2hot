defaultCC:=gcc-4.6.3

CC_SPECIFIC:=-g -Wall
ARCH_SPECIFIC:=-march=corei7-avx -DSTK_FORCE_ALIGNMENT=4 -D_FILE_OFFSET_BITS=64 -DUSE_SYSTEM_MALLOC -DUSE_MPIIO -DUSE_HWCLOCK -DPROCS_PER_NODE=16 -DCUDA
OPTIMIZE=-O2
AGGRESSIVE_OPT=-Ofast
LDFLAGS=-g
LEX:=flex
YACC:=bison -y

CUDACC=/opt/cudatoolkit-4.1/bin/nvcc
CUDACFLAGS=-Xptxas="-v" -use_fast_math -arch=sm_20 -ccbin /usr/bin -I/opt/cudatoolkit-4.1/include -I$(TREEHOME)/include
override LD=$(CUDACC)

include $(treedir)/Make-common/Make.default

swsrc:=lsv.c swampi.c
asmdir:=asm-sse
asmsrc=do_grav_sse64_noswiz.s do_grav_sse64_noswiz_eps.s do_grav_sse64_nr.s
cppasmsrc=do_grav_sse16_ivec.S

LOADLIBES=-lrt

ifeq ($(PAROS),mpi)
LOADLIBES:=-L$(MPI_ROOT)/lib -L$(MPI_ROOT)/lib64 -lmpi -lslurm
PAROSCFLAGS:=-I$(MPI_ROOT)/include
endif

ifeq ($(PAROS),mvapich2)
LOADLIBES:=-L/usr/projects/packages/hpctools/mustang/mvapich2/1.7-gcc/lib64 -lmpich -lmpl -lslurm
PAROSCFLAGS:=-I/usr/projects/packages/hpctools/mustang/mvapich2/1.7-gcc/include
endif

